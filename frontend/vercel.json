{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/kullanici", "dest": "/kullanici.html" },
    { "src": "/personel", "dest": "/personel.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/reset-password", "dest": "/reset-password.html" }
  ]
}
